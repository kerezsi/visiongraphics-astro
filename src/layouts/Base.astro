---
// src/layouts/Base.astro
// Root HTML shell — used by all pages

import { LOCALES, localeFromPath, swapLocale, type Locale } from '../lib/i18n';

interface Props {
  title:       string;
  description?: string;
  image?:      string;  // OG image path
  noIndex?:    boolean;
}

const {
  title,
  description = 'Expert 3D architectural visualization. Budapest-based, working globally since 1996. Stills, animation, VR, AI-enhanced workflows.',
  image = '/og-default.jpg',
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title === 'Vision Graphics'
  ? 'Vision Graphics Kft. — Architectural Visualization, Budapest'
  : `${title} | Vision Graphics Kft.`;

// Active locale — set by page templates via Astro.locals.lang; fall back to
// the URL prefix so <html lang> and hreflang alternates are always right.
const lang: Locale = (Astro.locals as { lang?: Locale })?.lang ?? localeFromPath(Astro.url.pathname);
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', hu: 'hu_HU' };
const alternates = LOCALES.map(l => ({
  hreflang: l,
  href: new URL(swapLocale(Astro.url.pathname, l), Astro.site).toString(),
}));

// Build-time cache-buster. Cloudflare Pages content-addresses uploaded assets
// by hash — when dedupe thinks a hash is already uploaded but the edge blob is
// missing/corrupted, the canonical URL serves a 500 with empty body. Including
// a per-build timestamp ensures every HTML file's hash changes on every build,
// bypassing the stale-manifest condition.
const buildStamp = new Date().toISOString();
---

<!doctype html>
<html lang={lang}>
<head>
  <!-- Theme: apply before first paint to avoid flash of wrong theme -->
  <script is:inline>
    (function(){
      var t = localStorage.getItem('vg-theme') ||
              (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      if (t === 'light') document.documentElement.dataset.theme = 'light';
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="x-build" content={buildStamp} />

  <!-- Primary Meta -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
  {noIndex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph -->
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={new URL(image, Astro.site).toString()} />
  <meta property="og:url"         content={canonical} />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Vision Graphics Kft." />
  <meta property="og:locale"      content={OG_LOCALE[lang]} />
  {LOCALES.filter(l => l !== lang).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={new URL(image, Astro.site).toString()} />

  <!-- Favicon -->
  <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon"             type="image/png"     href="/favicon.png" />
  <link rel="apple-touch-icon"                      href="/apple-touch-icon.png" />

  <!-- Fonts (preconnect first, then load) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;500&family=DM+Mono:wght@400&display=swap"
  />

</head>
<body>
  <slot />

  <!-- PhotoSwipe — auto-scans [data-pswp-gallery] containers -->
  <script>
    import '../lib/photoswipe.ts';
  </script>

  <!-- External links (any other host, subdomains included) open in a new tab. -->
  <script>
    // ponytail: one pass at load; links an island injects later stay same-tab — add a MutationObserver if that ever matters.
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
      if (a.host !== location.host) { a.target = '_blank'; a.relList.add('noopener'); }
    }
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/components.css';
</style>
