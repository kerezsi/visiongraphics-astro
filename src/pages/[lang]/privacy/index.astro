---
// src/pages/[lang]/privacy/index.astro
//
// GDPR-compliant Privacy Policy. Bilingual content is held in two parallel
// arrays (en / hu) of { heading, body[] } sections so the layout stays the
// same in both locales. The visible body lines are paragraphs — keep them
// short for readability. HTML in body strings is intentionally rendered
// raw via set:html since we use <a> tags for the few inline links.

import Page from '../../../layouts/Page.astro';
import SectionBanner from '../../../components/ui/SectionBanner.astro';
import { staticLocalePaths, type Locale, localeUrl } from '../../../lib/i18n';
import { ui } from '../../../i18n/strings';

export const getStaticPaths = staticLocalePaths;
const { lang } = Astro.params as { lang: Locale };
Astro.locals.lang = lang;
const L = ui(lang);

const LAST_UPDATED = '2026-05-27';

type Section = { heading: string; body: string[] };

const EN: { meta: { title: string; description: string }; intro: string; sections: Section[]; lastUpdated: string } = {
  meta: {
    title: 'Privacy Policy',
    description: 'How Vision Graphics Kft. handles your personal data — GDPR-compliant privacy notice for visiongraphics.eu.',
  },
  intro:
    'This notice explains what personal data we collect when you visit visiongraphics.eu or contact us, why we collect it, how long we keep it, and the rights you have under the EU General Data Protection Regulation (GDPR) and Hungarian Act CXII of 2011 (Infotv.).',
  lastUpdated: `Last updated: ${LAST_UPDATED}`,
  sections: [
    {
      heading: 'Who we are (data controller)',
      body: [
        'Vision Graphics Kft.',
        'Registered seat and mailing address: H-1126 Budapest, Hollósy Simon utca 15., Hungary',
        'Company registration: 01-09-564319 (Court of Registration: Fővárosi Törvényszék Cégbírósága)',
        'Tax number: 12203688-2-43',
        'Email: <a href="mailto:info@visiongraphics.hu">info@visiongraphics.hu</a>',
        'Phone: +36 30 945 4179',
        'Web: <a href="https://www.visiongraphics.hu">www.visiongraphics.hu</a>',
      ],
    },
    {
      heading: 'What data we collect',
      body: [
        '<strong>Contact form (visiongraphics.eu/contact/):</strong> name, email address, and the contents of your message. Optionally: company / organisation, project type, deadline. You provide this data voluntarily by submitting the form.',
        '<strong>Server logs:</strong> our hosting provider (Cloudflare Inc.) records the standard request metadata for every page view — IP address, user agent, referrer, timestamp, requested URL. This is used for security, abuse prevention, and aggregate performance monitoring.',
        '<strong>Browser storage:</strong> a single localStorage entry named <code>vg-theme</code> stores your dark/light mode preference so the site remembers it between visits. This value never leaves your browser and is not transmitted to us.',
        'We do <strong>not</strong> use analytics services, advertising trackers, social media pixels, or marketing cookies.',
      ],
    },
    {
      heading: 'Why we process it (purposes and legal basis)',
      body: [
        '<strong>To reply to your enquiry</strong> — basis: pre-contractual measures at your request (GDPR Art. 6(1)(b)) and our legitimate interest in responding to business communications (Art. 6(1)(f)).',
        '<strong>Site operation, security, and abuse prevention</strong> — basis: our legitimate interest in keeping the site available and protected from attacks (Art. 6(1)(f)).',
        '<strong>Legal compliance</strong> — where we are required by Hungarian or EU law to retain certain communications (e.g. accounting records related to a quoted project) — basis: Art. 6(1)(c).',
      ],
    },
    {
      heading: 'How long we keep it',
      body: [
        '<strong>Contact form messages</strong>: emails are delivered to our Google Workspace mailbox at <code>info@visiongraphics.hu</code> and are <strong>not deleted by default</strong>. We retain them as part of our project correspondence archive. You may request deletion at any time (see "Your rights" below); statutory accounting-related retention may apply to messages that became part of a contractual relationship.',
        '<strong>Server logs</strong>: Cloudflare retains standard access logs according to its own retention policy (typically a few days for raw logs, longer for aggregated metrics). See <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare\'s privacy policy</a>.',
        '<strong>Browser theme preference</strong>: stored in your browser until you clear it.',
      ],
    },
    {
      heading: 'Who we share it with (recipients and processors)',
      body: [
        '<strong>Resend Inc.</strong> (USA) — transmits the contact form email from our website to our mailbox. Acts as data processor. Cross-border transfer covered by EU Standard Contractual Clauses. <a href="https://resend.com/legal/privacy-policy">Resend privacy policy</a>.',
        '<strong>Google LLC / Google Ireland Ltd.</strong> — provides our Google Workspace mailbox where contact form emails are stored. Acts as data processor. <a href="https://workspace.google.com/terms/dpa_terms.html">Google Workspace DPA</a>.',
        '<strong>Cloudflare Inc.</strong> (USA / global CDN) — hosts the main website at visiongraphics.eu and processes all HTTP traffic. Acts as data processor. <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare privacy policy</a>.',
        '<strong>Tárhely.Eu Kft.</strong> (Hungary) — hosts the 360° tour content at <code>pano.visiongraphics.eu</code>. Acts as data processor.',
        'We do not sell or rent your data to anyone. We do not share it for advertising or profiling purposes.',
      ],
    },
    {
      heading: 'Cookies and similar technologies',
      body: [
        'visiongraphics.eu does not set marketing, advertising, or analytics cookies, and does not require a cookie consent banner.',
        '<strong>Strictly necessary storage we use:</strong> one localStorage entry (<code>vg-theme</code>) to remember your dark/light mode choice. This is exempt from consent requirements under the ePrivacy Directive Art. 5(3).',
        '<strong>Cookies set by Cloudflare:</strong> Cloudflare may set strictly necessary security cookies such as <code>__cf_bm</code> (bot management) on its own initiative. These are essential for protecting the site from automated abuse and do not require consent.',
        '<strong>Third-party embeds (YouTube, Vimeo):</strong> video and tour embeds use a "facade" pattern — only a static thumbnail loads on page view. When you click play, the YouTube or Vimeo iframe loads and the respective provider may set its own cookies and process data according to its privacy policy (<a href="https://policies.google.com/privacy">YouTube/Google</a>, <a href="https://vimeo.com/privacy">Vimeo</a>). The 360° tours on <code>pano.visiongraphics.eu</code> are hosted on our own infrastructure and do not set tracking cookies.',
      ],
    },
    {
      heading: 'International transfers',
      body: [
        'Resend Inc., Google LLC, and Cloudflare Inc. are US-based companies that process some data outside the European Economic Area. These transfers are covered by EU Standard Contractual Clauses (SCCs) and, where applicable, the EU-US Data Privacy Framework. We do not transfer data to countries without an adequate level of protection.',
      ],
    },
    {
      heading: 'Your rights',
      body: [
        'Under GDPR (Articles 15–22) you have the right to:',
        '— Access the personal data we hold about you, and receive a copy.',
        '— Have inaccurate data corrected (rectification).',
        '— Have your data erased ("right to be forgotten"), subject to overriding legal-retention obligations.',
        '— Restrict our processing while a dispute is being resolved.',
        '— Receive your data in a portable, machine-readable format.',
        '— Object to processing based on our legitimate interest.',
        '— Withdraw consent at any time, where processing is based on consent (this does not affect lawfulness of prior processing).',
        'To exercise any of these rights, email <a href="mailto:info@visiongraphics.hu">info@visiongraphics.hu</a>. We will respond within 30 days.',
        'You also have the right to lodge a complaint with the Hungarian Data Protection Authority: <strong>Nemzeti Adatvédelmi és Információszabadság Hatóság (NAIH)</strong>, 1055 Budapest, Falk Miksa utca 9–11., phone +36-1-391-1400, web <a href="https://naih.hu/">naih.hu</a>.',
      ],
    },
    {
      heading: 'Children',
      body: [
        'The site is intended for an adult professional audience and is not directed at children under 16. We do not knowingly collect personal data from minors. If you believe a minor has provided us data, please contact us so we can delete it.',
      ],
    },
    {
      heading: 'Automated decision-making',
      body: [
        'We do not use automated decision-making or profiling that produces legal or similarly significant effects.',
      ],
    },
    {
      heading: 'Changes to this notice',
      body: [
        'We may update this notice from time to time as our practices or applicable law change. The "Last updated" date at the top reflects the most recent revision. Material changes will be highlighted on the contact page.',
      ],
    },
    {
      heading: 'Questions',
      body: [
        'Any question about this notice or how we handle your data: <a href="mailto:info@visiongraphics.hu">info@visiongraphics.hu</a> or +36 30 945 4179.',
      ],
    },
  ],
};

