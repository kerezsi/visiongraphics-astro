const C = lang === 'hu' ? HU : EN;
---

<Page
  title={C.meta.title}
  description={C.meta.description}
  fullBleed
>
  <div class="legal-page">

    <SectionBanner
      image="/_img/banners/banner-general.jpg"
      label={lang === 'hu' ? 'Jogi nyilatkozat' : 'Legal'}
      title={C.meta.title}
      headingLevel="h1"
      size="page"
    />

    <section class="section legal-section">
      <div class="container legal-container">

        <p class="legal-updated">{C.lastUpdated}</p>
        <p class="legal-intro">{C.intro}</p>

        {C.sections.map(section => (
          <article class="legal-block">
            <h2 class="legal-heading">{section.heading}</h2>
            {section.body.map(line => (
              <p class="legal-body" set:html={line} />
            ))}
          </article>
        ))}

        <p class="legal-footer-note">
          <a href={localeUrl('/impressum/', lang)}>
            {lang === 'hu' ? 'Impresszum' : 'Imprint'}
          </a>
          {' · '}
          <a href={localeUrl('/contact/', lang)}>{L.nav.contact}</a>
        </p>

      </div>
    </section>

  </div>
</Page>

<style>
  .legal-page { width: 100%; }

  .legal-section {
    padding-block: clamp(2.5rem, 4vw, 4rem);
  }

  .legal-container {
    max-width: 820px;
  }

  .legal-updated {
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .legal-intro {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: var(--space-12);
    max-width: 72ch;
  }

  .legal-block {
    margin-bottom: var(--space-10);
  }

  .legal-heading {
    font-size: var(--fs-h5);
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
    line-height: 1.3;
  }

  .legal-body {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0 0 var(--space-3);
    max-width: 72ch;
  }

  .legal-body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease;
  }

  .legal-body :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }

  .legal-body :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.92em;
    background: var(--color-surface);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .legal-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .legal-footer-note {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-small);
    color: var(--color-text-faint);
  }

  .legal-footer-note a {
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .legal-footer-note a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
</style>
