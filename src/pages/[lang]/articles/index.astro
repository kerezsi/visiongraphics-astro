---
// src/pages/articles/index.astro

import Page from '../../../layouts/Page.astro';
import SectionBanner from '../../../components/ui/SectionBanner.astro';
import { getCollection } from 'astro:content';
import { thumbUrl } from '../../../lib/image-url';
import { staticLocalePaths, localeUrl, tStr, type Locale } from '../../../lib/i18n';
import { ui } from '../../../i18n/strings';
import { formatDate, readingTime } from '../../../lib/article-meta';

export const getStaticPaths = staticLocalePaths;


const { lang } = Astro.params as { lang: Locale };
Astro.locals.lang = lang;
const L = ui(lang);
const allArticles = await getCollection('articles', ({ data }) => data.published);
const articles = allArticles.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Page
  title={L.articles.metaTitle}
  description={L.articles.metaDesc}
  fullBleed
>
  <div class="articles-page">

    <SectionBanner
      image="/_img/banners/banner-general.jpg"
      label={L.articles.bannerLabel}
      title={L.articles.bannerTitle}
      size="page"
      headingLevel="h1"
    />

    <section class="articles-section section">
    <div class="container">

    <div class="articles-header">
      <p class="section-label">{L.articles.sectionLabel}</p>
      <p class="articles-intro">{L.articles.intro}</p>
      {L.articles.enOnlyNote && <p class="articles-note">{L.articles.enOnlyNote}</p>}
    </div>

    {articles.length > 0 ? (
      <div class="articles-list">
        {articles.map((article, i) => (
          <a href={localeUrl(`/articles/${article.slug}/`, lang)} lang="en" class:list={['article-item', { 'article-item--featured': i === 0 }]}>
            {article.data.coverImage && (
              <div class="article-image">
                <img
                  src={thumbUrl(article.data.coverImage)}
                  alt={tStr(article.data.title, lang)}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  onerror={`this.onerror=null;this.src='${article.data.coverImage}'`}
                />
              </div>
            )}
            <div class="article-body">
              <div class="article-meta">
                <time class="article-date" datetime={article.data.date.toISOString()}>
                  {formatDate(article.data.date, lang)}
                </time>
                <span class="article-date">{L.articles.readingTime.replace('{n}', String(readingTime(article.body)))}</span>
                {article.data.tags.length > 0 && (
                  <div class="article-tags">
                    {article.data.tags.slice(0, 3).map(tag => (
                      <span class="article-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <h2 class="article-title">{tStr(article.data.title, lang)}</h2>
              <p class="article-excerpt">{tStr(article.data.excerpt, lang)}</p>
              <span class="article-read-more">{L.articles.readArticle}</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="articles-empty">
        <p>{L.articles.emptyTitle}</p>
        <p class="articles-empty-sub">
          {L.articles.emptyPrefix}<a href={localeUrl('/contact/', lang)}>{L.articles.emptyLink}</a>{L.articles.emptySuffix}
        </p>
      </div>
    )}

    </div>
    </section>
  </div>
</Page>

<style>
  .articles-page { width: 100%; }
  .articles-section { padding-block: clamp(3rem, 5vw, 5rem); }

  .articles-header { margin-bottom: 3rem; }

  .articles-intro {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    max-width: 55ch;
    line-height: 1.7;
    margin: 0;
  }

  /* HU-only notice: articles are published in English */
  .articles-note {
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    margin: var(--space-3) 0 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-accent);
  }

  /* List */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .article-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background 200ms;
  }

  .article-item:last-child { border-bottom: 1px solid var(--color-border); }

  .article-item--featured {
    grid-template-columns: 1fr 1fr;
  }

  .article-item:hover .article-title { color: var(--color-accent); }

  .article-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .article-item:hover .article-image img { transform: scale(1.03); }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    justify-content: center;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
  }

  .article-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .article-tag {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.45rem;
    border-radius: 1px;
  }

  .article-title {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 300;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.01em;
    transition: color 200ms;
    margin: 0;
  }

  .article-excerpt {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 60ch;
  }

  .article-read-more {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--color-accent);
    letter-spacing: 0.03em;
    margin-top: 0.25rem;
  }

  /* Empty state */
  .articles-empty {
    padding: 4rem 0;
    border-top: 1px solid var(--color-border);
  }

  .articles-empty p {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    max-width: none;
  }

  .articles-empty-sub { font-size: var(--fs-xs) !important; }

  .articles-empty a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .article-item--featured { grid-template-columns: 1fr; }
  }
</style>
