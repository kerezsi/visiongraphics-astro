---
// src/pages/articles/[slug].astro

import Page from '../../../layouts/Page.astro';
import { getCollection } from 'astro:content';
import ArticleImageCompareMounter from '../../../components/media/ArticleImageCompareMounter.tsx';
import ArticleGalleryMounter from '../../../components/media/ArticleGalleryMounter.tsx';
import Tour360 from '../../../components/media/Tour360.astro';
import FilmEmbed from '../../../components/media/FilmEmbed.astro';
import YouTubeEmbed from '../../../components/media/YouTubeEmbed.astro';
import SectionBanner from '../../../components/mdx/SectionBanner.astro';
import ImageGallery from '../../../components/mdx/ImageGallery.astro';
import ImageCompare from '../../../components/mdx/ImageCompare.astro';
import ProcessFlow from '../../../components/mdx/ProcessFlow.astro';
import SpecTable from '../../../components/mdx/SpecTable.astro';
import CompareTable from '../../../components/mdx/CompareTable.astro';
import NotableGrid from '../../../components/mdx/NotableGrid.astro';
import DeliverableGrid from '../../../components/mdx/DeliverableGrid.astro';
import TimelineTable from '../../../components/mdx/TimelineTable.astro';
import PhaseMatrix from '../../../components/mdx/PhaseMatrix.astro';
import SingleImage from '../../../components/mdx/SingleImage.astro';
import { localizedPaths, localeUrl, tStr, type Locale } from '../../../lib/i18n';
import { ui } from '../../../i18n/strings';
import { formatDate, readingTime } from '../../../lib/article-meta';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.published);
  return localizedPaths(articles, article => ({ slug: article.slug }));
}

const { lang, slug } = Astro.params as { lang: Locale; [k: string]: string | undefined };
Astro.locals.lang = lang;
Astro.locals.pageType = 'article';
const L = ui(lang);
const allArticles = await getCollection('articles', ({ data }) => data.published);
const article = allArticles.find(a => a.slug === slug);
if (!article) return Astro.redirect(localeUrl('/articles/', lang));
const { data } = article;
const { Content } = await article.render();
const minutes = readingTime(article.body);
// Articles are EN-only plain strings today, but the schema allows {en,hu} — flatten (§4.1).
const title   = tStr(data.title, lang);
const excerpt = tStr(data.excerpt, lang);

// Article JSON-LD — author/publisher facts mirror the sidebar and footer.
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: data.date.toISOString(),
  inLanguage: 'en',
  image: data.coverImage ? new URL(data.coverImage, Astro.site).toString() : undefined,
  author: { '@type': 'Person', name: 'László Kerezsi' },
  publisher: { '@type': 'Organization', name: 'Vision Graphics Kft.', url: 'https://visiongraphics.eu/' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
});

// Adjacent articles for navigation
const sorted = [...allArticles].sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const currentIndex = sorted.findIndex(a => a.slug === article.slug);
const prevArticle = sorted[currentIndex + 1] ?? null;
const nextArticle = sorted[currentIndex - 1] ?? null;
---

<Page
  title={title}
  description={excerpt}
  image={data.coverImage}
  fullBleed
>
  <script type="application/ld+json" set:html={articleJsonLd} is:inline />
  <div class="article-page">
  <div class="container article-inner">

    <!-- Breadcrumb -->
    <nav class="article-breadcrumb" aria-label={L.a11y.breadcrumb}>
      <a href={localeUrl('/articles/', lang)}>{L.articles.breadcrumbRoot}</a>
      <span aria-hidden="true">→</span>
      <span aria-current="page" lang="en">{title}</span>
    </nav>

    <!-- Header — articles are authored in English; mark the prose as such on /hu/ -->
    <header class="article-header" lang="en">
      <div class="article-meta">
        <time class="article-date" datetime={data.date.toISOString()}>
          {formatDate(data.date, lang)}
        </time>
        <span class="article-date">{L.articles.readingTime.replace('{n}', String(minutes))}</span>
        {data.tags.length > 0 && (
          <div class="article-tags">
            {data.tags.map(tag => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
      <h1 class="display-lg article-h1">{title}</h1>
      <p class="article-excerpt">{excerpt}</p>
    </header>

    {data.coverImage && (
      <div class="article-cover">
        <img src={data.coverImage} alt={title} loading="eager" />
      </div>
    )}

    <!-- Content -->
    <div class="article-layout">
      <div class="article-content prose" lang="en">
        <Content components={{ SectionBanner, ImageGallery, ImageCompare, SingleImage, Tour360, FilmEmbed, YouTubeEmbed, YoutubeEmbed: YouTubeEmbed, ProcessFlow, SpecTable, CompareTable, NotableGrid, DeliverableGrid, TimelineTable, PhaseMatrix }} />
        <ArticleImageCompareMounter client:load />
        <ArticleGalleryMounter client:load />
      </div>

      <aside class="article-sidebar">
        <div class="sidebar-block">
          <h3 class="sidebar-label">{L.articles.aboutAuthor}</h3>
          <p class="sidebar-author-name">{lang === 'hu' ? 'Kerezsi László' : 'László Kerezsi'}</p>
          <p class="sidebar-author-bio">{L.articles.authorBio}</p>
        </div>

        <div class="sidebar-block">
          <h3 class="sidebar-label">{L.articles.contact}</h3>
          <a href={localeUrl('/contact/', lang)} class="btn btn-primary sidebar-btn">{L.articles.startProject}</a>
        </div>
      </aside>
    </div>

    <!-- Navigation -->
    <nav class="article-nav" aria-label={L.a11y.articleNav}>
      {prevArticle && (
        <a href={localeUrl(`/articles/${prevArticle.slug}/`, lang)} class="article-nav-link article-nav-link--prev">
          <span class="nav-dir">{L.articles.older}</span>
          <span class="nav-title" lang="en">{tStr(prevArticle.data.title, lang)}</span>
        </a>
      )}
      <a href={localeUrl('/articles/', lang)} class="article-nav-link article-nav-link--all">{L.articles.allArticles}</a>
      {nextArticle && (
        <a href={localeUrl(`/articles/${nextArticle.slug}/`, lang)} class="article-nav-link article-nav-link--next">
          <span class="nav-dir">{L.articles.newer}</span>
          <span class="nav-title" lang="en">{tStr(nextArticle.data.title, lang)}</span>
        </a>
      )}
    </nav>

  </div>
  </div>
</Page>

<style>
  .article-page { width: 100%; }
  .article-inner { padding-block: clamp(3rem, 5vw, 5rem); }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    margin-bottom: 2rem;
  }

  .article-breadcrumb a { color: var(--color-text-muted); text-decoration: none; transition: color 200ms; }
  .article-breadcrumb a:hover { color: var(--color-accent); }

  /* Header */
  .article-header { margin-bottom: 2rem; }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .article-date {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
  }

  .article-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }

  .article-tag {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.45rem;
    border-radius: 1px;
  }

  .article-h1 { margin: 0 0 1rem; }

  .article-excerpt {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    max-width: 62ch;
    line-height: 1.65;
    margin: 0;
  }

  /* Cover */
  .article-cover {
    margin-bottom: 3rem;
    aspect-ratio: 16/7;
    overflow: hidden;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }

  .article-cover img { width: 100%; height: 100%; object-fit: cover; }

  /* Layout */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 4rem;
    align-items: start;
  }

  /* Section banner blocks inside article prose */
  .article-content.prose :global(.article-section-banner) {
    position: relative;
    height: clamp(80px, 14vw, 180px);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    border-radius: var(--radius-sm);
    margin: 2rem 0;
    display: flex;
    align-items: flex-end;
  }

  .article-content.prose :global(.article-section-banner__overlay) {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.2) 100%);
  }
  :global([data-theme="light"]) .article-content.prose :global(.article-section-banner__overlay) {
    background: linear-gradient(to top, rgba(247,245,242,0.88) 0%, rgba(247,245,242,0.25) 100%);
  }

  .article-content.prose :global(.article-section-banner__content) {
    position: relative;
    padding: 0.75rem 1rem;
    z-index: 1;
  }

  .article-content.prose :global(.article-section-banner__label) {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.25rem;
  }

  .article-content.prose :global(.article-section-banner__title) {
    font-size: var(--fs-h5);
    font-weight: 300;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  /* Prose content */
  .article-content.prose {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 65ch;
  }

  .article-content.prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 300;
    color: var(--color-text);
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
  }

  .article-content.prose :global(h3) {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text);
    margin: 2rem 0 0.75rem;
  }

  .article-content.prose :global(p) {
    margin-bottom: 1.25rem;
    max-width: none;
  }

  .article-content.prose :global(ul),
  .article-content.prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .article-content.prose :global(li) {
    margin-bottom: 0.4rem;
    color: var(--color-text-muted);
    font-size: var(--fs-small);
  }

  .article-content.prose :global(code) {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    background: var(--color-surface-2);
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    color: var(--color-accent);
  }

  .article-content.prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-body);
    color: var(--color-text-muted);
  }

  /* Sidebar */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 5rem;
  }

  .sidebar-block { display: flex; flex-direction: column; gap: 0.6rem; }

  .sidebar-label {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .sidebar-author-name {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    max-width: none;
  }

  .sidebar-author-bio {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: none;
  }

  .sidebar-btn { width: 100%; justify-content: center; }

  /* Navigation */
  .article-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    gap: 1rem;
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    transition: color 200ms;
    max-width: 35%;
  }

  .article-nav-link--all {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    flex-direction: row;
    align-items: center;
    max-width: none;
  }

  .article-nav-link--all:hover { color: var(--color-text); }
  .article-nav-link--next { text-align: right; align-items: flex-end; }

  .nav-dir {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nav-title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    line-height: 1.3;
    transition: color 200ms;
  }

  .article-nav-link:hover .nav-title { color: var(--color-accent); }

  /* Responsive */
  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-sidebar { position: static; }
  }
</style>
