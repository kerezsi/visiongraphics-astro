---
// src/pages/[lang]/articles/[slug].astro — article detail. Chrome is
// localized; an article is bilingual when its title is {en,hu} and its prose
// sits in paired <Lang> blocks, otherwise it renders as EN on both locales
// (marked lang="en"). Layout and spacing come from the shared blocks and
// tokens only — no page-local px/rem.

import Page from '../../../layouts/Page.astro';
import { getCollection } from 'astro:content';
import ArticleImageCompareMounter from '../../../components/media/ArticleImageCompareMounter.tsx';
import ArticleGalleryMounter from '../../../components/media/ArticleGalleryMounter.tsx';
import Tour360 from '../../../components/media/Tour360.astro';
import FilmEmbed from '../../../components/media/FilmEmbed.astro';
import YouTubeEmbed from '../../../components/media/YouTubeEmbed.astro';
import SectionBanner from '../../../components/mdx/SectionBanner.astro';
import ImageGallery from '../../../components/mdx/ImageGallery.astro';
import ImageCompare from '../../../components/mdx/ImageCompare.astro';
import ProcessFlow from '../../../components/mdx/ProcessFlow.astro';
import SpecTable from '../../../components/mdx/SpecTable.astro';
import CompareTable from '../../../components/mdx/CompareTable.astro';
import NotableGrid from '../../../components/mdx/NotableGrid.astro';
import DeliverableGrid from '../../../components/mdx/DeliverableGrid.astro';
import TimelineTable from '../../../components/mdx/TimelineTable.astro';
import PhaseMatrix from '../../../components/mdx/PhaseMatrix.astro';
import SingleImage from '../../../components/mdx/SingleImage.astro';
import ChipRow from '../../../components/ui/ChipRow.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Lang from '../../../components/i18n/Lang.astro';
import { localizedPaths, localeUrl, tStr, hasLocale, type Locale } from '../../../lib/i18n';
import { ui } from '../../../i18n/strings';
import { formatDate, readingTime } from '../../../lib/article-meta';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.published);
  return localizedPaths(articles, article => ({ slug: article.slug }));
}

const { lang, slug } = Astro.params as { lang: Locale; [k: string]: string | undefined };
Astro.locals.lang = lang;
Astro.locals.pageType = 'article';
const L = ui(lang);
const allArticles = await getCollection('articles', ({ data }) => data.published);
const article = allArticles.find(a => a.slug === slug);
if (!article) return Astro.redirect(localeUrl('/articles/', lang));
const { data } = article;
const { Content } = await article.render();
const minutes = readingTime(article.body, lang);
// A plain-string title means an EN-only article (a plain string counts as "available" to
// hasLocale, so check the shape first). Flatten either way (§4.1).
const isHu = (t: unknown) => typeof t !== 'string' && hasLocale(t as never, 'hu');
const proseLang: Locale = isHu(data.title) ? lang : 'en';
const title   = tStr(data.title, lang);
const excerpt = tStr(data.excerpt, lang);
const authorName = lang === 'hu' ? 'Kerezsi László' : 'László Kerezsi';

// Tag chips link back to the filtered index (?tag=, same as the index pills).
const tagChips = data.tags.map(tag => ({
  href: `${localeUrl('/articles/', lang)}?tag=${encodeURIComponent(tag)}`,
  text: tag.replace(/-/g, ' '),
}));

// Article JSON-LD — author/publisher facts mirror the sidebar and footer.
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: data.date.toISOString(),
  inLanguage: proseLang,
  image: data.coverImage ? new URL(data.coverImage, Astro.site).toString() : undefined,
  author: { '@type': 'Person', name: 'László Kerezsi' },
  publisher: { '@type': 'Organization', name: 'Vision Graphics Kft.', url: 'https://visiongraphics.eu/' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
});

// Adjacent articles for navigation
const sorted = [...allArticles].sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const currentIndex = sorted.findIndex(a => a.slug === article.slug);
const prevArticle = sorted[currentIndex + 1] ?? null;
const nextArticle = sorted[currentIndex - 1] ?? null;
---

<Page
  title={title}
  description={excerpt}
  image={data.coverImage}
  fullBleed
>
  <script type="application/ld+json" set:html={articleJsonLd} is:inline />
  <div class="article-page">
  <div class="container article-inner">

    <!-- Breadcrumb -->
    <nav class="article-breadcrumb" aria-label={L.a11y.breadcrumb}>
      <a href={localeUrl('/articles/', lang)}>{L.articles.breadcrumbRoot}</a>
      <span aria-hidden="true">→</span>
      <span aria-current="page" lang={proseLang}>{title}</span>
    </nav>

    <!-- Header — an EN-only article is marked lang="en" on /hu/ -->
    <header class="article-header" lang={proseLang}>
      <div class="article-meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
        <span>{L.articles.readingTime.replace('{n}', String(minutes))}</span>
      </div>
      <h1 class="display-lg article-h1">{title}</h1>
      <p class="article-excerpt">{excerpt}</p>
      {tagChips.length > 0 && <ChipRow label={L.articles.topics} chips={tagChips} class="article-tags" />}
    </header>

    {data.coverImage && (
      <div class="article-cover">
        <img src={data.coverImage} alt={title} loading="eager" />
      </div>
    )}

    <!-- Content — markdown images arrive as <SingleImage> (remarkArticleImages in astro.config.mjs) -->
    <div class="article-layout">
      <div class="article-content prose" lang={proseLang}>
        <Content components={{ SectionBanner, ImageGallery, ImageCompare, SingleImage, Tour360, FilmEmbed, YouTubeEmbed, YoutubeEmbed: YouTubeEmbed, ProcessFlow, SpecTable, CompareTable, NotableGrid, DeliverableGrid, TimelineTable, PhaseMatrix, Lang }} />
        <ArticleImageCompareMounter client:load />
        <ArticleGalleryMounter client:load />
      </div>

      <aside class="article-sidebar">
        <SectionHeading level="h3" label={L.articles.aboutAuthor} title={authorName} intro={L.articles.authorBio} />
        <div class="sidebar-block">
          <p class="eyebrow">{L.articles.contact}</p>
          <a href={localeUrl('/contact/', lang)} class="btn btn-primary sidebar-btn">{L.articles.startProject}</a>
        </div>
      </aside>
    </div>

    <!-- Navigation -->
    <nav class="article-nav" aria-label={L.a11y.articleNav}>
      {prevArticle && (
        <a href={localeUrl(`/articles/${prevArticle.slug}/`, lang)} class="article-nav-link article-nav-link--prev">
          <span class="nav-dir">{L.articles.older}</span>
          <span class="nav-title" lang={isHu(prevArticle.data.title) ? lang : 'en'}>{tStr(prevArticle.data.title, lang)}</span>
        </a>
      )}
      <a href={localeUrl('/articles/', lang)} class="eyebrow article-nav-link article-nav-link--all">{L.articles.allArticles}</a>
      {nextArticle && (
        <a href={localeUrl(`/articles/${nextArticle.slug}/`, lang)} class="article-nav-link article-nav-link--next">
          <span class="nav-dir">{L.articles.newer}</span>
          <span class="nav-title" lang={isHu(nextArticle.data.title) ? lang : 'en'}>{tStr(nextArticle.data.title, lang)}</span>
        </a>
      )}
    </nav>

  </div>
  </div>
</Page>

<style>
  .article-page { width: 100%; }
  .article-inner { padding-block: var(--space-12) var(--space-16); }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    margin-bottom: var(--space-8);
  }
  .article-breadcrumb a { color: var(--color-text-muted); }
  .article-breadcrumb a:hover { color: var(--color-accent); }

  /* Header */
  .article-header { margin-bottom: var(--space-8); }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
  }
  .article-h1 { margin: 0 0 var(--space-4); }
  .article-excerpt {
    font-size: var(--fs-body);
    color: var(--color-text-muted);
    max-width: 62ch;
    line-height: 1.65;
    margin: 0;
  }
  .article-tags { margin-top: var(--space-4); }

  /* Cover */
  .article-cover {
    margin-bottom: var(--space-12);
    aspect-ratio: 16/7;
    overflow: hidden;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }
  .article-cover img { width: 100%; height: 100%; object-fit: cover; }

  /* Layout: prose column + sticky sidebar */
  .article-layout {
    display: grid;
    grid-template-columns: 1fr 14rem;
    gap: var(--space-16);
    align-items: start;
  }

  /* Prose — block components (SectionBanner, SingleImage, galleries) bring their own styles */
  .article-content.prose {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 65ch;
  }
  .article-content.prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-h5);
    font-weight: 300;
    color: var(--color-text);
    margin: var(--space-10) 0 var(--space-4);
    letter-spacing: -0.01em;
  }
  .article-content.prose :global(h3) {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--color-text);
    margin: var(--space-8) 0 var(--space-3);
  }
  .article-content.prose :global(p) { margin-bottom: var(--space-5); max-width: none; }
  .article-content.prose :global(ul),
  .article-content.prose :global(ol) { padding-left: var(--space-6); margin-bottom: var(--space-5); }
  .article-content.prose :global(li) { margin-bottom: var(--space-2); }
  .article-content.prose :global(p a) { color: var(--color-accent); }
  .article-content.prose :global(code) {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    background: var(--color-surface-2);
    padding: 0 var(--space-1);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
  }
  .article-content.prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-5);
    margin: var(--space-6) 0;
    font-style: italic;
    font-size: var(--fs-body);
  }

  /* Sidebar */
  .article-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: sticky;
    top: calc(var(--size-header) + var(--space-4));
  }
  .article-sidebar :global(.section-heading) { margin-bottom: 0; }
  .sidebar-block { display: flex; flex-direction: column; gap: var(--space-3); }
  .sidebar-btn { width: 100%; justify-content: center; }

  /* Navigation */
  .article-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .article-nav-link { display: flex; flex-direction: column; gap: var(--space-1); max-width: 35%; }
  .article-nav-link--all { flex-direction: row; max-width: none; }
  .article-nav-link--all:hover { color: var(--color-text); }
  .article-nav-link--next { text-align: right; align-items: flex-end; }
  .nav-dir {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .nav-title { font-size: var(--fs-body); color: var(--color-text-muted); line-height: 1.3; }
  .article-nav-link:hover .nav-title { color: var(--color-accent); }

  @media (max-width: 768px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-sidebar { position: static; }
  }
</style>
