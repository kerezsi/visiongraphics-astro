---
// src/pages/[lang]/pricing/estimate/index.astro — the full price calculator (every
// card kind) with the packages above it: a package card loads its lines into the
// calculator (#p=… hash), where every card and quantity can be changed.
import Page from '../../../../layouts/Page.astro';
import SectionBanner from '../../../../components/ui/SectionBanner.astro';
import SectionHeading from '../../../../components/ui/SectionHeading.astro';
import PackageGrid from '../../../../components/pricing/PackageGrid.astro';
import Estimator from '../../../../components/pricing/Estimator.astro';
import { staticLocalePaths, localeUrl, type Locale } from '../../../../lib/i18n';

export const getStaticPaths = staticLocalePaths;
const { lang } = Astro.params as { lang: Locale };
Astro.locals.lang = lang;

const COPY = {
  en: {
    metaTitle: 'Price calculator',
    metaDescription: 'Estimate your architectural visualization project line by line from the public price list: exterior and interior stills, 360° tours, film, floor plans, AI images, interactive tools. Start from a package or from scratch.',
    bannerLabel: 'Investment', bannerTitle: 'Price calculator', back: '← Price list',
    packages: 'Packages',
    packagesIntro: 'Fixed combinations of list items — Hungarian dog breeds, by size. The price is computed from the list. Pick one to load it into the calculator below, then change any line.',
  },
  hu: {
    metaTitle: 'Árkalkulátor',
    metaDescription: 'Becsülje meg építészeti látványtervezési projektjét tételről tételre a nyilvános árlistából: külső és belső képek, 360°-os túrák, film, alaprajzok, AI képek, interaktív eszközök. Induljon egy csomagból vagy a nulláról.',
    bannerLabel: 'Befektetés', bannerTitle: 'Árkalkulátor', back: '← Árlista',
    packages: 'Csomagok',
    packagesIntro: 'Rögzített kombinációk a lista tételeiből — magyar kutyafajták, méret szerint. Az ár a listából számolódik. Válasszon egyet, betöltődik az alábbi kalkulátorba, és bármelyik tétel módosítható.',
  },
} as const;
const c = COPY[lang];
---

<Page title={c.metaTitle} description={c.metaDescription} fullBleed>
  <SectionBanner image="/_img/banners/banner-general.jpg" label={c.bannerLabel} title={c.bannerTitle} size="page" headingLevel="h1" />
  <section class="section">
    <div class="container">
      <p class="est-back"><a href={localeUrl('/pricing/', lang)}>{c.back}</a></p>
      <div class="est-block">
        <SectionHeading title={c.packages} intro={c.packagesIntro} />
        <PackageGrid lang={lang} />
      </div>
      <Estimator lang={lang} />
    </div>
  </section>
</Page>

<style>
  .est-back { font-size: var(--fs-xs); margin: 0 0 var(--space-6); }
  .est-back a { color: var(--color-accent); }
  .est-block { margin-bottom: var(--space-16); }
</style>
