---
// src/pages/[lang]/pricing/index.astro
//
// The public price list. Everything printed here comes from src/data/pricing.json
// (edited with the pricing admin at localhost:4322/pricing/) through the shared
// math in src/lib/pricing.mjs — packages are computed from the module list at
// build time, never typed by hand. Internal multipliers (framework, rush,
// source…) are deliberately not shown; they live on quotes only.
//
// Layout is standard components only: SectionHeading / Callout / BulletList /
// CtaPanel (ui) + PriceList (pricing). Packages live on /pricing/estimate/
// (PackageGrid), where they load into the calculator. No page-local styling
// beyond block rhythm.

import Page from '../../../layouts/Page.astro';
import SectionBanner from '../../../components/ui/SectionBanner.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import Callout from '../../../components/ui/Callout.astro';
import BulletList from '../../../components/ui/BulletList.astro';
import CtaPanel from '../../../components/ui/CtaPanel.astro';
import PriceList from '../../../components/pricing/PriceList.astro';
import { staticLocalePaths, localeUrl, type Locale } from '../../../lib/i18n';
import { ui } from '../../../i18n/strings';
import raw from '../../../data/pricing.json';
import { fmtBoth, publicView, fmt, type PricingData } from '../../../lib/pricing.mjs';

export const getStaticPaths = staticLocalePaths;
const { lang } = Astro.params as { lang: Locale };
Astro.locals.lang = lang;
const L = ui(lang);

const data = raw as unknown as PricingData;
const P = publicView(data);
const t = (v: { en: string; hu: string } | undefined) => (v ? v[lang] : '');
// quote-only multipliers stay unpublished — the copy names the levers without their factors
// the calculator lives on /pricing/estimate/ (components/pricing/Estimator.astro); this page only links it
const estimateUrl = localeUrl('/pricing/estimate/', lang);

const COPY = {
  en: {
    metaTitle: 'Pricing',
    metaDescription: `Architectural visualization price list ${P.version}: model preparation, exterior and interior stills, 360° tours, film, AI images, interactive tools. Packages from ${fmt(P.presets[0].total, lang)}. Vision Graphics Kft., Budapest.`,
    bannerLabel: 'Investment',
    bannerTitle: 'Pricing',
    label: 'Price list ' + P.version,
    h2: 'One list.',
    h2em: 'Every quote is built from it.',
    intro: 'These are the prices we quote from — no package tiers, no hidden extras. Pick lines by code, or start from a package in the price calculator. Prices are net EUR; Hungarian quotes are converted at a fixed rate set each January.',
    lanes: 'Two fidelity lanes, not three tiers',
    lanesBody: 'Most deliverables exist in a 3D lane (modelled, rendered, finished by hand) and an AI lane (generated from your existing image, lightly retouched). We quote both where it makes sense; you choose per item. Small budgets go to the AI lane, never to a cheaper 3D still.',
    list: 'Module list',
    listIntro: 'Every line we sell, by family. Codes are stable — quote by code.',
    terms: 'Terms on every quote',
    termsIntro: 'The short version. The full',
    termsLink: 'General Terms and Conditions',
    termsTail: 'apply to every order.',
    up: 'What drives cost up', down: 'What keeps cost down',
    upList: ['Film instead of stills — an order of magnitude', 'Number of distinct camera angles', 'Interior detail: furnishing, bespoke materials', 'Rush timelines', 'Plan revisions after ordering'],
    downList: ['A usable 3D model instead of 2D plans', 'A clear brief and one plan version at ordering', 'Repetition — unit types, panorama blocks, short bundles', 'The AI lane where photoreal 3D is not needed', 'A framework agreement for repeat work'],
    ctaH: 'Not sure which fits?',
    ctaP: '30-minute consultation, no charge. We scope the project together and send a quote by code.',
    updated: 'Prices valid from',
    calcTitle: 'Price calculator',
    calcIntro: 'Describe the project as subjects — building, interiors, show flats — with their own outputs, add film or plans, and see the total computed with the same math we quote with.',
    calcOpen: 'Open the price calculator',
  },
  hu: {
    metaTitle: 'Árak',
    metaDescription: `Építészeti látványtervezés árlista ${P.version}: modell-előkészítés, külső és belső látványképek, 360°-os túrák, film, AI képek, interaktív eszközök. Csomagok ${fmtBoth(P.presets[0].total, lang, P.peg)}-tól. Vision Graphics Kft., Budapest.`,
    bannerLabel: 'Befektetés',
    bannerTitle: 'Árak',
    label: 'Árlista ' + P.version,
    h2: 'Egy lista.',
    h2em: 'Minden ajánlat ebből épül.',
    intro: 'Ezekből az árakból ajánlunk — nincsenek csomagsávok, nincsenek rejtett tételek. Válasszon tételeket kód szerint, vagy induljon az árkalkulátor egyik csomagjából. Nettó euróárak; a magyar ajánlatokat a januárban rögzített árfolyamon számítjuk át.',
    lanes: 'Két minőségi vonal, nem három sáv',
    lanesBody: 'A legtöbb anyag létezik 3D vonalon (modellezve, renderelve, kézzel befejezve) és AI vonalon (meglévő képből generálva, könnyű retusálással). Ahol van értelme, mindkettőt ajánljuk; tételenként Ön választ. A kis költségvetés az AI vonalra kerül, sosem egy olcsóbb 3D képre.',
    list: 'Tétellista',
    listIntro: 'Minden tétel, amit árulunk, családonként. A kódok állandóak — kód szerint ajánlunk.',
    terms: 'Feltételek minden ajánlaton',
    termsIntro: 'A rövid változat. Minden megrendelésre a teljes',
    termsLink: 'Általános Szerződési Feltételek',
    termsTail: 'vonatkoznak.',
    up: 'Mi növeli az árat', down: 'Mi csökkenti az árat',
    upList: ['Film állókép helyett — nagyságrendi különbség', 'Az eltérő kameraállások száma', 'Belső részletesség: berendezés, egyedi anyagok', 'Sürgős határidő', 'Tervmódosítás megrendelés után'],
    downList: ['Használható 3D modell 2D tervek helyett', 'Egyértelmű brief és egy tervverzió megrendeléskor', 'Ismétlődés — lakástípusok, panorámablokkok, rövidfilm-csomag', 'Az AI vonal, ahol nem kell fotorealisztikus 3D', 'Keretszerződés visszatérő munkára'],
    ctaH: 'Nem biztos benne, melyik illik Önhöz?',
    ctaP: '30 perces konzultáció, díjmentesen. Együtt mérjük fel a projektet, és kód szerinti ajánlatot küldünk.',
    updated: 'Árak érvényesek',
    calcTitle: 'Árkalkulátor',
    calcIntro: 'Írja le a projektet témák szerint — épület, belső terek, mintalakások — saját anyagaikkal, adjon hozzá filmet vagy alaprajzokat, és a végösszeg ugyanazzal a képlettel számolódik, amivel ajánlatot adunk.',
    calcOpen: 'Árkalkulátor megnyitása',
  },
} as const;
const c = COPY[lang];
---

<Page title={c.metaTitle} description={c.metaDescription} fullBleed>
  <SectionBanner
    image="/_img/banners/banner-general.jpg"
    label={c.bannerLabel}
    title={c.bannerTitle}
    size="page"
    headingLevel="h1"
  />

  <section class="section">
    <div class="container">

      <div class="pricing-block">
        <SectionHeading label={c.label} size="lg" intro={c.intro}>
          <Fragment slot="title">{c.h2}<br /><em>{c.h2em}</em></Fragment>
          <Callout title={c.lanes} text={c.lanesBody} />
        </SectionHeading>
      </div>

      <div class="pricing-block" id="estimate">
        <SectionHeading title={c.calcTitle} intro={c.calcIntro} />
        <a href={estimateUrl} class="btn btn-primary">{c.calcOpen}</a>
      </div>

      <div class="pricing-block">
        <SectionHeading title={c.list} intro={c.listIntro} />
        <PriceList lang={lang} />
      </div>

      <div class="pricing-block">
        <SectionHeading title={c.terms}>
          <Fragment slot="intro">{c.termsIntro} <a href={localeUrl('/terms/', lang)}>{c.termsLink}</a> {c.termsTail}</Fragment>
        </SectionHeading>
        <BulletList items={P.terms.map(t)} marker="dash" columns={2} html />
      </div>

      <div class="pricing-block panel-grid">
        <BulletList title={c.up} items={c.upList} marker="up" />
        <BulletList title={c.down} items={c.downList} marker="down" />
      </div>

      <CtaPanel title={c.ctaH} text={c.ctaP} href={localeUrl('/contact/', lang)} cta={L.cta.getInTouch} />

      <p class="pricing-foot">{c.updated} {P.updated} · {c.label}</p>

    </div>
  </section>
</Page>

<style>
  .pricing-block { margin-bottom: var(--space-16); scroll-margin-top: var(--size-header); }
  .pricing-foot { font-size: var(--fs-xs); color: var(--color-text-faint); margin: var(--space-4) 0 0; }
</style>
