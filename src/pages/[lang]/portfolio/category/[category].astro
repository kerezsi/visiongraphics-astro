---
// src/pages/[lang]/portfolio/category/[category].astro
// Pre-built category pages for SEO. Every value that could be Localized<T>
// (category titles, project titles, reference titles) goes through tStr().

import Page from '../../../../layouts/Page.astro';
import SectionBanner from '../../../../components/ui/SectionBanner.astro';
import { getCollection, getEntry } from 'astro:content';
import { thumbUrl } from '../../../../lib/image-url';
import { localizedPaths, localeUrl, tStr, type Locale } from '../../../../lib/i18n';
import { ui } from '../../../../i18n/strings';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects', ({ data }) => data.published);
  const categoryIds = [...new Set(allProjects.flatMap(p => p.data.categories.map(c => c.id)))];
  return localizedPaths(categoryIds, categoryId => ({ category: categoryId }));
}

const { lang, category } = Astro.params as { lang: Locale; [k: string]: string | undefined };
Astro.locals.lang = lang;
const L = ui(lang);
const allProjects = await getCollection('projects', ({ data }) => data.published);
const allCategories = await getCollection('categories');
// Content-type collection: `c.id` is "residential.md", references carry the slug.
const catMap = new Map(allCategories.map(c => [c.slug, tStr(c.data.title, lang)]));
const label = catMap.get(category!) || category!;
const projects = allProjects
  .filter(p => p.data.categories.some(c => c.id === category))
  .sort((a, b) => b.data.year - a.data.year);
if (!projects.length) return Astro.redirect(localeUrl('/portfolio/', lang));

const fill = (tmpl: string, vars: Record<string, string | number>) =>
  tmpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

// Resolve titles + client/location for every card (locale-aware)
const cards = await Promise.all(
  projects.map(async p => {
    const client  = p.data.client  ? tStr((await getEntry('clients',   p.data.client.id))?.data.title,  lang) : '';
    const city    = p.data.city    ? tStr((await getEntry('cities',    p.data.city.id))?.data.title,    lang) : '';
    const country = p.data.country ? tStr((await getEntry('countries', p.data.country.id))?.data.title, lang) : '';
    const location = [city, country].filter(Boolean).join(', ');
    return {
      slug:  p.slug,
      title: tStr(p.data.displayTitle, lang) || tStr(p.data.title, lang),
      year:  p.data.year,
      cover: p.data.coverImage,
      sub:   client || location,
      field: p.data.categories.length > 1 ? L.portfolio.mixed : label,
    };
  })
);

const countText = projects.length === 1
  ? L.category.countOne
  : fill(L.category.countMany, { n: projects.length });
---

<Page
  title={`${label} ${L.category.metaSuffix}`}
  description={fill(L.category.metaDesc, { label, n: projects.length })}
  fullBleed
>
  <SectionBanner
    image="/_img/banners/banner-arch-viz.jpg"
    label={L.category.label}
    title={label}
    size="page"
    headingLevel="h1"
  />
  <div class="category-page">

    <div class="category-header container">
      <nav class="category-breadcrumb" aria-label={L.a11y.breadcrumb}>
        <a href={localeUrl('/portfolio/', lang)}>{L.nav.portfolio}</a>
        <span aria-hidden="true">→</span>
        <span aria-current="page">{label}</span>
      </nav>
      <p class="category-sub">
        {countText}
        <a href={localeUrl('/portfolio/', lang)}>{L.category.browseAll}</a>
      </p>
    </div>

    <div class="category-grid container">
      {cards.map((card, i) => (
        <a href={localeUrl(`/portfolio/${card.slug}/`, lang)} class="cat-card pf-card">
          <div class="cat-card-image">
            <img
              src={thumbUrl(card.cover)}
              alt={card.title}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              onerror={`this.onerror=null;this.src='${card.cover}'`}
            />
          </div>
          <div class="cat-card-body">
            <div class="cat-card-meta">
              <span class="cat-card-cat">{card.field}</span>
              <span class="cat-card-year">{card.year}</span>
            </div>
            <h2 class="cat-card-title">{card.title}</h2>
            {card.sub && <span class="cat-card-sub">{card.sub}</span>}
          </div>
        </a>
      ))}
    </div>

    <div class="category-cta container">
      <a href={localeUrl('/portfolio/', lang)} class="btn btn-secondary">{L.category.allProjects}</a>
      <a href={localeUrl('/contact/', lang)} class="btn btn-primary">{L.category.startProject}</a>
    </div>

  </div>
</Page>

<style>
  .category-page { padding-block: clamp(3rem, 6vw, 5rem); }

  .category-header { margin-bottom: var(--space-12); }

  .category-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    margin-bottom: var(--space-4);
  }

  .category-breadcrumb a { color: var(--color-text-muted); text-decoration: none; transition: color 200ms; }
  .category-breadcrumb a:hover { color: var(--color-accent); }

  .category-sub {
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    margin: 0;
  }

  .category-sub a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: var(--space-2);
  }

  /* Grid — matches the portfolio filter grid */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(280px, 22%), 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  /* Card — border colours come from the shared .pf-card rules in global.css */
  .cat-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid;
    border-radius: var(--radius-sm);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 250ms ease, transform 250ms ease;
  }

  .cat-card:hover { transform: translateY(-2px); }

  .cat-card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .cat-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .cat-card:hover .cat-card-image img { transform: scale(1.04); }

  .cat-card-body {
    padding: var(--space-4) var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .cat-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cat-card-cat {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cat-card-year {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
  }

  .cat-card-title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
    margin: 0;
  }

  .cat-card-sub {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .category-cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
</style>
