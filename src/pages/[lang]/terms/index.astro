---
// src/pages/[lang]/terms/index.astro
//
// General Terms and Conditions (ÁSZF) for Vision Graphics Kft.'s visualization
// services. Same shape as privacy/: two parallel { heading, body[] } arrays so
// EN and HU keep identical structure. Commercial numbers (payment split,
// revision rounds, rush, hosting, indexation) mirror the price list
// (src/data/pricing.json terms[]) — change them there first, then here.
// Body strings are rendered raw (set:html) for the few inline links/emphasis.

import Page from '../../../layouts/Page.astro';
import SectionBanner from '../../../components/ui/SectionBanner.astro';
import { staticLocalePaths, type Locale, localeUrl } from '../../../lib/i18n';
import { ui } from '../../../i18n/strings';

export const getStaticPaths = staticLocalePaths;
const { lang } = Astro.params as { lang: Locale };
Astro.locals.lang = lang;
const L = ui(lang);

const EFFECTIVE = '2026-10-01';
const pricing = localeUrl('/pricing/', lang);
const privacy = localeUrl('/privacy/', lang);

type Section = { heading: string; body: string[] };
type Doc = { meta: { title: string; description: string }; intro: string; effective: string; sections: Section[] };

