---
// src/components/ui/CtaPanel.astro — bordered call-to-action: title, line, one button.
interface Props { title: string; text?: string; href: string; cta: string }
const { title, text, href, cta } = Astro.props;
---

<div class="cta-panel">
  <div>
    <h2 class="cta-panel__title">{title}</h2>
    {text && <p class="cta-panel__text">{text}</p>}
  </div>
  <a href={href} class="btn btn-primary">{cta}</a>
</div>

<style>
  .cta-panel {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;
    gap: var(--space-8);
    padding: var(--space-10);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .cta-panel__title { font-family: var(--font-display); font-size: var(--fs-h5); font-weight: 300; color: var(--color-text); margin: 0 0 var(--space-2); }
  .cta-panel__text { font-size: var(--fs-small); color: var(--color-text-muted); margin: 0; }
</style>
