---
// src/components/ui/DepthImage.astro
// Full-bleed 2.5D parallax image (src/lib/hero-depth.ts) that fills its positioned
// parent. `set` = [image, depthMap] pairs — one is picked at random per visit, set[0]
// is the <noscript> still. WebGL / image / CORS failure → the same image as a CSS still.
// Runs under prefers-reduced-motion too — owner's call (2026-09-16): the moving render is the pitch.
interface Props { set: [string, string][]; class?: string }
const { set, class: cls } = Astro.props;
---

<div class:list={['depth-image', cls]} data-set={JSON.stringify(set)} aria-hidden="true">
  <canvas></canvas>
  <noscript><style is:inline set:html={`.depth-image{background-image:url(${set[0][0]})}`}></style></noscript>
</div>

<script>
  import { heroDepth } from '../../lib/hero-depth';
  for (const el of document.querySelectorAll<HTMLElement>('.depth-image')) {
    const canvas = el.querySelector('canvas')!;
    const set = JSON.parse(el.dataset.set!) as [string, string][];
    const [img, depth] = set[Math.floor(Math.random() * set.length)];
    const still = () => {
      el.style.setProperty('--img', `url(${img})`);
      el.classList.remove('is-live');
      el.classList.add('is-still');
    };
    heroDepth(canvas, img, depth, still).then(() => el.classList.add('is-live'), still);
  }
</script>

<style>
  /* No background-color here: on project pages this sits over the semantic <img>.
     background-image only via .is-still / <noscript> so the two never fight. */
  .depth-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .depth-image.is-still { background-image: var(--img); }

  .depth-image canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .depth-image.is-live canvas { opacity: 1; }
</style>
