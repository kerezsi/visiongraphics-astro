---
// src/components/pricing/Estimator.astro — the price calculator.
//
// Full version on /pricing/estimate/ (every tab); service pages embed the tabs
// that carry their slug (pricing.json calculator.tabs[].services) with a link
// back to the full calculator. Math and data come from pricing.mjs /
// pricing.json through calcView(); state lives in the URL hash.
import raw from '../../data/pricing.json';
import { calcView, type PricingData } from '../../lib/pricing.mjs';
import { localeUrl, type Locale } from '../../lib/i18n';

interface Props { lang: Locale; tabs?: string[]; embedded?: boolean; title?: string; intro?: string }
const { lang, tabs, embedded = false, title, intro } = Astro.props;
const t = (v: { en: string; hu: string } | undefined) => (v ? v[lang] : '');

const COPY = {
  en: {
    calcTitle: 'Estimate your project',
    calcIntro: 'Pick a service, set quantities, and the total is computed from the list with the same math we quote with. Combine tabs freely — one estimate, one quote request. The link in your address bar carries the estimate.',
    calcTotal: 'Estimate, net EUR',
    calcRequest: 'Request this quote',
    calcReset: 'Clear all',
    calcNote: 'Point estimate from list prices. Rush and framework terms are settled on the quote.',
    calc: { source: 'What you can supply', sourceNote: 'Applies to model preparation (MOD).', types: 'Distinct unit types', typesNote: 'Repeated flat types make plans cheaper.', typical: 'Add the typical set', min: 'min.', empty: 'Nothing selected yet.', needsMod: 'Rendered items need model preparation (MOD) on the same order.', underMin: 'A film line is under its minimum length.', closest: 'Closest package:', above: 'above', below: 'below', msgHead: 'Estimate from the price list', total: 'Total', net: 'net' },
    fullCalc: 'Full price calculator with every service →',
    backToList: '← Price list',
  },
  hu: {
    calcTitle: 'Becsülje meg a projektjét',
    calcIntro: 'Válasszon szolgáltatást, állítsa be a mennyiségeket, és a végösszeg a listából számolódik ugyanazzal a képlettel, amivel ajánlatot adunk. A fülek szabadon kombinálhatók — egy becslés, egy ajánlatkérés. A címsorban lévő link a becslést is hordozza.',
    calcTotal: 'Becslés, nettó EUR',
    calcRequest: 'Ajánlatot kérek erre',
    calcReset: 'Törlés',
    calcNote: 'Pontbecslés listaárakból. Sürgősségi és keretszerződéses feltételek az ajánlatban.',
    calc: { source: 'Amit át tud adni', sourceNote: 'A modell-előkészítésre (MOD) vonatkozik.', types: 'Különböző lakástípusok', typesNote: 'Az ismétlődő típusok olcsóbbá teszik az alaprajzokat.', typical: 'Tipikus készlet hozzáadása', min: 'min.', empty: 'Még nincs kiválasztva semmi.', needsMod: 'A renderelt tételekhez modell-előkészítés (MOD) kell ugyanazon a megrendelésen.', underMin: 'Egy filmtétel a minimális hossz alatt van.', closest: 'Legközelebbi csomag:', above: 'fölötte', below: 'alatta', msgHead: 'Becslés az árlistából', total: 'Összesen', net: 'nettó' },
    fullCalc: 'Teljes árkalkulátor minden szolgáltatással →',
    backToList: '← Árlista',
  },
} as const;
const c = COPY[lang];

const all = calcView(raw as unknown as PricingData);
const tabDefs = tabs ? all.calculator.tabs.filter((T) => tabs.includes(T.key)) : all.calculator.tabs;
// embedded pages only ship the items their tabs can price
const codes = new Set(tabDefs.flatMap((T) => T.rows.map((r) => r.code)));
const calc = { ...all, items: tabs ? all.items.filter((i) => codes.has(i.code)) : all.items, calculator: { tabs: tabDefs } };
const estimateUrl = localeUrl('/pricing/estimate/', lang);
const calcJson = JSON.stringify({ lang, ui: { ...c.calc, contactUrl: localeUrl('/contact/', lang), estimateUrl }, ...calc }).replace(/</g, '\\u003c');
const uid = tabs ? tabs.join('-') : 'all';
---

{tabDefs.length > 0 && (
  <section class="calc" id="estimate">
    <h2 class="block-title">{title ?? c.calcTitle}</h2>
    <p class="block-intro">{intro ?? c.calcIntro}</p>
    {tabDefs.length > 1 && (
      <div class="calc-tabs" role="tablist">
        {tabDefs.map((T, i) => (
          <button type="button" role="tab" class="calc-tab" data-tab={T.key} aria-selected={i === 0 ? 'true' : 'false'}>{t(T.name)}<span class="calc-tab-sum"></span></button>
        ))}
      </div>
    )}
    <div class="calc-grid">
      <div class="calc-main">
        <p class="calc-lede" id="calc-lede"></p>
        <div id="calc-rows" class="calc-rows"></div>
      </div>
      <aside class="calc-sum">
        <p class="calc-sum-label">{c.calcTotal}</p>
        <p class="calc-total" id="calc-total">—</p>
        <p class="calc-near" id="calc-near"></p>
        <ul class="calc-warns" id="calc-warn"></ul>
        <ul class="calc-lines" id="calc-lines"></ul>
        <a id="calc-request" href={localeUrl('/contact/', lang)} class="btn btn-primary">{c.calcRequest}</a>
        <button type="button" id="calc-reset" class="calc-reset">{c.calcReset}</button>
        {embedded && <a id="calc-full" href={estimateUrl} class="calc-full">{c.fullCalc}</a>}
        <p class="calc-note">{c.calcNote}</p>
      </aside>
    </div>
    <script is:inline type="application/json" id="calc-data" data-tabs={uid} set:html={calcJson}></script>
  </section>
)}

<script>
  // Estimator. State = the same {qty, source, types} the quote math takes; the
  // whole state lives in the URL hash (#e=tab;source;CODE:n,…) — no storage.
  import { quote, defaultState, fmt, fmtHuf, item } from '../../lib/pricing.mjs';
  const dataEl = document.getElementById('calc-data');
  if (dataEl) {
    const D = JSON.parse(dataEl.textContent || '{}');
    const { lang, ui, calculator: C } = D;
    const t = (v: any) => (v ? v[lang] : '');
    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    const S: any = defaultState(D);
    let tab = C.tabs[0].key;
    const srcOpts = D.multipliers.source.options;
    const shared = new Set(C.tabs.flatMap((T: any) => T.rows.map((r: any) => r.code)).filter((c: string, i: number, a: string[]) => a.indexOf(c) !== i));

    const parse = () => {
      const m = location.hash.match(/^#e=([^;]*);?([^;]*);?(.*)$/);
      if (!m) return;
      if (C.tabs.some((x: any) => x.key === m[1])) tab = m[1];
      const so = srcOpts.find((o: any) => o.key === m[2]); if (so) S.source = so.value;
      for (const p of (m[3] || '').split(',')) { const [c, n] = p.split(':'); if (c === 'types' && +n > 0) S.types = +n; else if (item(D, c) && +n > 0) S.qty[c] = +n; }
    };
    const srcKey = () => (srcOpts.find((o: any) => o.value === S.source) || srcOpts[0]).key;
    const write = () => history.replaceState(null, '', `#e=${tab};${srcKey()};${Object.entries(S.qty).filter(([, n]: any) => n > 0).map(([c, n]) => c + ':' + n).concat(S.types !== 10 ? ['types:' + S.types] : []).join(',')}`);

    const curTab = () => C.tabs.find((x: any) => x.key === tab);
    const has = (c: string) => (S.qty[c] || 0) > 0;
    const tabEmpty = (T: any) => T.rows.every((r: any) => !has(r.code) || shared.has(r.code));
    const applyDefaults = (T: any) => {
      const hasShared = T.rows.some((r: any) => shared.has(r.code) && has(r.code));
      for (const r of T.rows) if (!has(r.code) && !(hasShared && shared.has(r.code))) S.qty[r.code] = r.default;
    };
    const sub = (rows: any[]) => quote(D, { ...S, qty: Object.fromEntries(rows.map((r) => [r.code, S.qty[r.code] || 0])) }).total;
    // what the typical-set button would add: defaults applied on a copy, minus the current total
    const typical = (T: any) => { const c = { ...S, qty: { ...S.qty } }; const hasShared = T.rows.some((r: any) => shared.has(r.code) && has(r.code)); for (const r of T.rows) if (!has(r.code) && !(hasShared && shared.has(r.code))) c.qty[r.code] = r.default; return quote(D, c).total - quote(D, S).total; };
    const money = (n: number) => fmt(n, lang) + (lang === 'hu' ? `<small>${fmtHuf(n, S.peg)}</small>` : '');

    function lineCell(it: any, l: any) {
      return (l ? fmt(l.line, lang) : `<span class="calc-unitprice">${fmt(it.base, lang)} / ${t(it.unit)}</span>`) +
        (l && l.underMin ? `<small>${ui.min} ${it.min} ${t(it.unit)}</small>` : '');
    }
    function renderRows() {
      const T = curTab();
      const by = Object.fromEntries(quote(D, S).lines.map((l: any) => [l.it.code, l]));
      document.querySelectorAll('.calc-tab').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.tab === tab)));
      $('#calc-lede').textContent = t(T.lede);
      $('#calc-rows').innerHTML =
        (T.source ? `<label class="calc-src"><span>${ui.source}</span><select id="calc-src">${srcOpts.map((o: any) => `<option value="${o.key}"${o.value === S.source ? ' selected' : ''}>${t(o.label)} ×${o.value}</option>`).join('')}</select><small>${ui.sourceNote}</small></label>` : '') +
        (T.types ? `<label class="calc-src"><span>${ui.types}</span><input type="number" id="calc-types" min="1" step="1" value="${S.types}"><small>${ui.typesNote}</small></label>` : '') +
        (tabEmpty(T) ? `<button type="button" class="calc-typical" id="calc-typical">+ ${ui.typical} · ${fmt(typical(T), lang)}</button>` : '') +
        T.rows.map((r: any) => { const it = item(D, r.code); return `
          <div class="calc-row" data-row="${it.code}">
            <span class="price-code">${it.code}</span>
            <span class="calc-name${it.help ? ' tip' : ''}"${it.help ? ` tabindex="0" data-tip="${esc(t(it.help))}"` : ''}>${t(it.name)}${it.desc ? `<small>${t(it.desc)}</small>` : ''}</span>
            <span class="calc-qty"><input type="number" inputmode="numeric" min="0" step="${r.step || 1}" value="${S.qty[r.code] || 0}" data-c="${r.code}" aria-label="${esc(t(it.name))}"><span class="calc-unit">${t(it.unit)}</span></span>
            <span class="calc-line">${lineCell(it, by[r.code])}</span>
          </div>`; }).join('');
    }
    function renderSum() {
      write();
      const full = document.getElementById('calc-full') as HTMLAnchorElement | null;
      if (full) full.href = ui.estimateUrl + location.hash;
      const Q = quote(D, S);
      $('#calc-total').innerHTML = money(Q.total);
      $('#calc-lines').innerHTML = Q.lines.map((l: any) => `<li><span class="price-code">${l.it.code}</span><span>${l.q} ${t(l.it.unit)} · ${t(l.it.name)}</span><b>${fmt(l.line, lang)}</b></li>`).join('') || `<li class="calc-empty">${ui.empty}</li>`;
      const warn = []; if (Q.missing.length) warn.push(ui.needsMod); if (Q.lines.some((l: any) => l.underMin)) warn.push(ui.underMin);
      $('#calc-warn').innerHTML = warn.map((w) => `<li>${w}</li>`).join('');
      let near = '';
      if (Q.total > 0) {
        const p = D.presets.reduce((a: any, b: any) => (Math.abs(b.total - Q.total) < Math.abs(a.total - Q.total) ? b : a));
        const d = Q.total - p.total;
        near = `${ui.closest} <b>${p.name}</b> ${fmt(p.total, lang)} · ${fmt(Math.abs(d), lang)} ${d >= 0 ? ui.above : ui.below}`;
      }
      $('#calc-near').innerHTML = near;
      C.tabs.forEach((T: any) => { const n = sub(T.rows.filter((r: any) => !shared.has(r.code))); const b = document.querySelector(`[data-tab="${T.key}"] .calc-tab-sum`); if (b) b.textContent = n ? fmt(n, lang) : ''; });
      const so = srcOpts.find((o: any) => o.value === S.source) || srcOpts[0];
      const msg = [`${ui.msgHead} ${D.version}`, ...Q.lines.map((l: any) => `${l.it.code} × ${l.q} ${t(l.it.unit)} — ${fmt(l.line, lang)}`), `${ui.source}: ${t(so.label)}`, `${ui.total}: ${fmt(Q.total, lang)} ${ui.net}`, ui.estimateUrl + location.hash].join('\n');
      ($('#calc-request') as HTMLAnchorElement).href = `${ui.contactUrl}?quote=${encodeURIComponent(msg)}`;
    }
    const render = () => { renderRows(); renderSum(); };

    $('#calc-rows').addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.id === 'calc-types') { S.types = Math.max(1, +el.value || 1); render(); return; }
      if (!el.dataset.c) return;
      S.qty[el.dataset.c] = Math.max(0, +el.value || 0);
      const by = Object.fromEntries(quote(D, S).lines.map((l: any) => [l.it.code, l]));
      document.querySelectorAll<HTMLElement>('.calc-row').forEach((row) => { row.querySelector('.calc-line')!.innerHTML = lineCell(item(D, row.dataset.row!), by[row.dataset.row!]); });
      if (!tabEmpty(curTab())) document.getElementById('calc-typical')?.remove();
      renderSum();
    });
    $('#calc-rows').addEventListener('change', (e) => {
      const el = e.target as HTMLSelectElement;
      if (el.id === 'calc-src') { S.source = srcOpts.find((o: any) => o.key === el.value).value; render(); }
    });
    $('#calc-rows').addEventListener('click', (e) => {
      if ((e.target as HTMLElement).id === 'calc-typical') { applyDefaults(curTab()); render(); }
    });
    document.querySelectorAll<HTMLElement>('.calc-tab').forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab!; render(); }));
    $('#calc-reset').addEventListener('click', () => { S.qty = {}; S.types = 10; render(); });

    parse();
    if (!Object.keys(S.qty).length) applyDefaults(curTab());
    render();
    if (location.hash.startsWith('#e=')) document.getElementById('estimate')?.scrollIntoView();
  }
</script>

<style is:global>
  /* Global on purpose: the rows are rendered client-side, so Astro's scoped selectors would not match them. */
  .calc .price-code { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--color-accent); white-space: nowrap; }
  .calc .block-title { font-family: var(--font-display); font-size: var(--fs-h5); font-weight: 300; color: var(--color-text); margin: 0 0 var(--space-3); }
  .calc .block-intro { font-size: var(--fs-small); color: var(--color-text-muted); max-width: 62ch; line-height: 1.7; margin: 0 0 var(--space-8); }
  .calc-full { font-size: var(--fs-xs); color: var(--color-accent); text-decoration: none; }
  .calc-full:hover { text-decoration: underline; }
  /* Estimator */
  .calc { margin-bottom: var(--space-16); scroll-margin-top: var(--size-header); }
  .calc-tabs { display: flex; flex-wrap: wrap; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); border-bottom: none; }
  .calc-tab {
    flex: 1 1 auto; display: flex; flex-direction: column; gap: 0.2rem; padding: var(--space-3) var(--space-4);
    background: var(--color-surface); border: none; color: var(--color-text-muted); cursor: pointer; text-align: left;
    font-family: var(--font-body); font-size: var(--fs-xs); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.3;
  }
  .calc-tab[aria-selected="true"] { background: var(--color-bg); color: var(--color-text); box-shadow: inset 0 2px 0 var(--color-accent); }
  .calc-tab-sum { font-family: var(--font-mono); text-transform: none; letter-spacing: 0; color: var(--color-accent); min-height: 1.2em; }
  .calc-grid { display: grid; grid-template-columns: 1fr 21rem; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .calc-main { background: var(--color-bg); min-width: 0; }
  .calc-lede { font-size: var(--fs-xs); color: var(--color-text-muted); line-height: 1.6; margin: 0; padding: var(--space-4) var(--space-5); background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .calc-src { display: grid; grid-template-columns: 11rem 1fr; gap: 0.25rem var(--space-4); align-items: center; padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--color-border); font-size: var(--fs-xs); color: var(--color-text-muted); }
  .calc-src small { grid-column: 2; color: var(--color-text-faint); }
  .calc-src select, .calc-src input, .calc-qty input {
    font-family: var(--font-mono); font-size: var(--fs-small); color: var(--color-text); background: var(--color-surface);
    border: 1px solid var(--color-border); padding: 0.3rem 0.5rem; max-width: 18rem;
  }
  .calc-src select:focus, .calc-src input:focus, .calc-qty input:focus { outline: none; border-color: var(--color-accent); }
  .calc-typical {
    margin: var(--space-4) var(--space-5) 0; padding: 0.5rem 0.9rem; background: none; cursor: pointer;
    border: 1px dashed var(--color-accent); color: var(--color-accent); font-family: var(--font-body); font-size: var(--fs-xs); letter-spacing: 0.05em;
  }
  .calc-typical:hover { background: var(--color-surface); }
  .calc-row { display: grid; grid-template-columns: 9rem 1fr 10rem 8rem; gap: var(--space-4); align-items: center; padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--color-border); }
  .calc-row:last-child { border-bottom: none; }
  .calc-name { font-size: var(--fs-small); color: var(--color-text); }
  .calc-name small { display: block; font-size: var(--fs-xs); color: var(--color-text-faint); margin-top: 0.15em; line-height: 1.45; }
  .calc-qty { display: flex; align-items: center; gap: 0.4rem; font-size: var(--fs-xs); color: var(--color-text-faint); }
  .calc-qty input { width: 5.5rem; text-align: right; }
  .calc-line { font-family: var(--font-mono); font-size: var(--fs-small); color: var(--color-text); text-align: right; white-space: nowrap; }
  .calc-unitprice { color: var(--color-text-faint); font-size: var(--fs-xs); }
  .calc-line small { display: block; font-family: var(--font-body); font-size: var(--fs-xs); color: var(--color-accent-2); }
  .calc-sum { background: var(--color-surface); padding: var(--space-6); position: sticky; top: calc(var(--size-header) + 1rem); align-self: start; display: flex; flex-direction: column; gap: var(--space-3); }
  .calc-sum-label { font-size: var(--fs-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-text-faint); margin: 0; }
  .calc-total { font-family: var(--font-mono); font-size: var(--fs-h4); color: var(--color-text); margin: 0; line-height: 1.1; letter-spacing: -0.02em; }
  .calc-total small { display: block; font-size: var(--fs-xs); color: var(--color-text-faint); margin-top: 0.3rem; letter-spacing: 0; }
  .calc-near, .calc-note { font-size: var(--fs-xs); color: var(--color-text-muted); margin: 0; line-height: 1.5; }
  .calc-near b { color: var(--color-text); font-weight: 500; }
  .calc-warns, .calc-lines { list-style: none; margin: 0; padding: 0; font-size: var(--fs-xs); }
  .calc-warns li { color: var(--color-accent-2); padding-left: 1rem; position: relative; line-height: 1.5; }
  .calc-warns li::before { content: '!'; position: absolute; left: 0; }
  .calc-lines { border-top: 1px solid var(--color-border); padding-top: var(--space-3); display: flex; flex-direction: column; gap: 0.35rem; max-height: 20rem; overflow: auto; }
  .calc-lines li { display: flex; gap: 0.5rem; align-items: baseline; color: var(--color-text-muted); line-height: 1.4; }
  .calc-lines li .price-code { flex: 0 0 auto; }
  .calc-lines li b { margin-left: auto; font-family: var(--font-mono); font-weight: 400; color: var(--color-text); white-space: nowrap; }
  .calc-empty { color: var(--color-text-faint); font-style: italic; }
  .calc-reset { background: none; border: none; padding: 0; color: var(--color-text-faint); font-family: var(--font-body); font-size: var(--fs-xs); cursor: pointer; text-decoration: underline; align-self: flex-start; }
  @media (max-width: 900px) {
    .calc-grid { grid-template-columns: 1fr; }
    .calc-sum { position: static; }
    .calc-row { grid-template-columns: 1fr auto; gap: var(--space-2) var(--space-4); }
    .calc-row .price-code { display: none; }
    .calc-name { grid-column: 1 / -1; }
    .calc-src { grid-template-columns: 1fr; }
    .calc-src small { grid-column: 1; }
  }

</style>
