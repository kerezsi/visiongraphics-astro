---
// src/components/pricing/Estimator.astro — the price calculator shell.
//
// The UI is src/lib/estimator.mjs (shared with the pricing admin's quote builder); this file
// ships the public data (calcView) and the locale, mounts the module and imports its CSS.
// Full version on /pricing/estimate/; service pages embed it scoped to the cards that carry
// their slug (pricing.json calculator.kinds[].services) with a link back to the full one.
// State lives in the URL hash (#p=…).
import raw from '../../data/pricing.json';
import { calcView, type PricingData } from '../../lib/pricing.mjs';
import { localeUrl, type Locale } from '../../lib/i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import '../../lib/estimator.css';

interface Props { lang: Locale; scope?: string[]; embedded?: boolean; title?: string; intro?: string }
const { lang, scope, embedded = false, title, intro } = Astro.props;

const COPY = {
  en: {
    title: 'Estimate your project',
    intro: 'Describe the project as subjects — the building, each interior space, show flats — with their own images and 360° viewpoints, then add project-wide outputs such as film or floor plans. The total is computed from the price list with the same math we quote with. The link in your address bar carries the estimate.',
  },
  hu: {
    title: 'Becsülje meg a projektjét',
    intro: 'Írja le a projektet témák szerint — az épület, minden belső tér, mintalakások — saját képekkel és 360°-os nézőpontokkal, majd adja hozzá a projektszintű anyagokat, például filmet vagy alaprajzokat. A végösszeg az árlistából számolódik, ugyanazzal a képlettel, amivel ajánlatot adunk. A címsorban lévő link a becslést is hordozza.',
  },
} as const;
const c = COPY[lang];

const D = calcView(raw as unknown as PricingData);
const kinds = scope ? D.calculator.kinds.filter((K) => scope.includes(K.key)) : D.calculator.kinds;
const opts = { lang, scope, embedded, contactUrl: localeUrl('/contact/', lang), estimateUrl: localeUrl('/pricing/estimate/', lang) };
const json = JSON.stringify({ D, opts }).replace(/</g, '\\u003c');
---

{kinds.length > 0 && (
  <section class="est" id="estimate">
    <SectionHeading title={title ?? c.title} intro={intro ?? c.intro} />
    <div class="est-root" data-estimator></div>
    <script is:inline type="application/json" data-estimator-data set:html={json}></script>
  </section>
)}

<script>
  import { mount } from '../../lib/estimator.mjs';
  const root = document.querySelector<HTMLElement>('[data-estimator]');
  const data = document.querySelector('[data-estimator-data]');
  if (root && data) {
    const { D, opts } = JSON.parse(data.textContent || '{}');
    mount(root, D, opts);
  }
</script>

<style>
  .est { margin-bottom: var(--space-16); }
</style>
