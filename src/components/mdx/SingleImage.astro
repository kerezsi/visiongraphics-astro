---
/**
 * SingleImage — one image with click-to-fullscreen via PhotoSwipe.
 *
 * Usage in MDX:
 *   <SingleImage src="/_img/vision-tech/slug/01.jpg" alt="Description" />
 *   <SingleImage src="/_img/..." alt="..." caption="Optional caption text" />
 */
import { tStr, DEFAULT_LOCALE, type Localized, type Locale } from '../../lib/i18n';
import { thumbUrl } from '../../lib/image-url';

interface Props {
  src: string;
  alt?: Localized<string>;
  caption?: Localized<string>;
}
const { src, alt, caption } = Astro.props;
const lang: Locale = (Astro.locals as { lang?: Locale })?.lang ?? DEFAULT_LOCALE;
const altStr     = tStr(alt, lang);
const captionStr = tStr(caption, lang);
const thumb      = thumbUrl(src, 'large') || src;
---

<figure class="mdx-single-image" data-pswp-gallery>
  <a
    href={src}
    class="mdx-single-image-trigger"
    aria-label="View full-size image"
    data-pswp-caption={captionStr || altStr || ''}
  >
    <img
      src={thumb}
      alt={altStr}
      class="mdx-single-image-img"
      loading="lazy"
      decoding="async"
    />
    <span class="mdx-single-image-zoom" aria-hidden="true">⊕</span>
  </a>

  {captionStr && <figcaption class="mdx-single-image-caption">{captionStr}</figcaption>}
</figure>

<style>
  .mdx-single-image {
    margin: var(--space-8) 0;
  }

  .mdx-single-image-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: var(--color-surface);
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .mdx-single-image-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
  }

  .mdx-single-image-trigger:hover .mdx-single-image-img {
    transform: scale(1.02);
  }

  .mdx-single-image-zoom {
    position: absolute;
    bottom: 0.6rem;
    right: 0.75rem;
    font-size: 1.1rem;
    color: rgba(240, 237, 232, 0.55);
    pointer-events: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    transition: color 200ms;
  }

  .mdx-single-image-trigger:hover .mdx-single-image-zoom {
    color: rgba(240, 237, 232, 0.9);
  }

  .mdx-single-image-caption {
    font-size: var(--fs-xs);
    color: var(--color-text-faint);
    text-align: center;
    margin-top: var(--space-2);
    font-style: italic;
    letter-spacing: 0.02em;
    max-width: none;
  }
</style>
