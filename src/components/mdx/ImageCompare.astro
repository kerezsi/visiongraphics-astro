---
import MediaLabel from './MediaLabel.astro';
import type { Localized } from '../../lib/i18n';

interface Props {
  before:     string;
  after:      string;
  beforeAlt?: string;
  afterAlt?:  string;
  /** Red label above. Default: "Compare:" / "Összehasonlítás:". `false` hides. */
  label?:     Localized<string> | false;
  /** Optional white subtitle. Empty = no line. */
  subtitle?:  Localized<string>;
}

const { before, after, beforeAlt = '', afterAlt = '', label, subtitle } = Astro.props;

const defaultLabel: Localized<string> = { en: 'Compare:', hu: 'Összehasonlítás:' };
const effectiveLabel = label === undefined ? defaultLabel : label;
---
<MediaLabel label={effectiveLabel} subtitle={subtitle} />
<div
  class="image-compare-mount"
  data-before-src={before}
  data-before-alt={beforeAlt}
  data-after-src={after}
  data-after-alt={afterAlt}
></div>
