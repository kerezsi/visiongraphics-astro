---
import MediaLabel from './MediaLabel.astro';
import { tStr, DEFAULT_LOCALE, type Localized, type Locale } from '../../lib/i18n';

interface Props {
  before:     string;
  after:      string;
  beforeAlt?: string;
  afterAlt?:  string;
  /** Red label above. Default: "Compare:" / "Összehasonlítás:". `false` hides. */
  label?:     Localized<string> | false;
  /** Optional white subtitle. Empty = no line. */
  subtitle?:  Localized<string>;
  /** Override the "Before" overlay label. Default: "Before" / "Előtte". */
  beforeText?: Localized<string>;
  /** Override the "After" overlay label. Default: "After" / "Utána". */
  afterText?:  Localized<string>;
}

const {
  before, after, beforeAlt = '', afterAlt = '',
  label, subtitle, beforeText, afterText,
} = Astro.props;

const defaultLabel:      Localized<string> = { en: 'Compare:', hu: 'Összehasonlítás:' };
const defaultBeforeText: Localized<string> = { en: 'Before',   hu: 'Előtte' };
const defaultAfterText:  Localized<string> = { en: 'After',    hu: 'Utána' };

const effectiveLabel = label === undefined ? defaultLabel : label;
const lang: Locale = (Astro.locals as { lang?: Locale })?.lang ?? DEFAULT_LOCALE;
const beforeLabel = tStr(beforeText ?? defaultBeforeText, lang);
const afterLabel  = tStr(afterText  ?? defaultAfterText,  lang);
---
<MediaLabel label={effectiveLabel} subtitle={subtitle} />
<div
  class="image-compare-mount"
  data-before-src={before}
  data-before-alt={beforeAlt}
  data-after-src={after}
  data-after-alt={afterAlt}
  data-before-text={beforeLabel}
  data-after-text={afterLabel}
></div>
